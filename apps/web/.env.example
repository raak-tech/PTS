# ── Database ──────────────────────────────────────────────────────────────────
# Required in production (Neon, etc.). Omit in local dev to use the local
# PostgreSQL `pts` database via unix socket (/var/run/postgresql).
# DATABASE_URL=postgresql://user:password@host:5432/pts

# ── Email (optional — password reset falls back to email_outbox table if unset)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false        # set to true for port 465
# EMAIL_USER=noreply@example.com
# EMAIL_PASS=your-smtp-password
# EMAIL_FROM="PTS Support <noreply@example.com>"

# ── Runtime ───────────────────────────────────────────────────────────────────
# NODE_ENV=production       # enables secure cookies, env validation
# OTP_TEST_MODE=true        # all registered phones accept OTP 123456 (pilot only) — remove before go-live; see docs/BEFORE_PRODUCTION.md
# PILOT_SHOW_PII=true       # pilot: show full phone/email in admin & counselor UIs (defaults on when OTP_TEST_MODE is on)
# OTP_FIXED_CODE=123456     # optional override when OTP_TEST_MODE is on
# MSG91_AUTH_KEY=           # omit or leave unset during pilot; required for live SMS
# MSG91_TEMPLATE_ID=
# CRON_SECRET=              # optional — authorizes Vercel cron /api/cron/intake-cleanup (90-day intake delete)

# ── Playwright (local dev only) ───────────────────────────────────────────────
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/snap/bin/chromium
# SKIP_DB_MIGRATE=1         # set when running tests against an already-migrated DB
