# Local dev — use your machine's LAN/Tailscale IP so remote browsers can reach the API
# API base URL for PTS backend (Next.js on Vercel).
# For local dev, point at your machine (e.g. http://192.168.x.x:3000).
# Release APK builds ignore this file — see scripts/build-apk-gradle.sh.
EXPO_PUBLIC_API_URL=https://pts-web-pied.vercel.app

# Set true only for offline prototype (mock accounts)
# EXPO_PUBLIC_USE_MOCK_AUTH=true

# Set true only to force the legacy multi-step intake form
# EXPO_PUBLIC_USE_LEGACY_INTAKE=true

# Pain Script pilot APK (package com.pts.mobile.painscript)
# EXPO_PUBLIC_PILOT_COHORT=pain_script
